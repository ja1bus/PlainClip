<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core（履歴・正規化・ダブルタップ判定・ショートカット・設定）の単体テスト。本体の exe には入らない。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../Core/PlainClip.Core.csproj" />
  </ItemGroup>
  <!-- LicenseTests 用に、同梱するライセンス表記をテストの出力へ写す。 -->
  <ItemGroup Condition="Exists('../public-repo/LICENSE')">
    <None Include="../public-repo/LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../public-repo/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 公開リポジトリでは LICENSE・THIRD-PARTY-NOTICES.md をルートに置く。 -->
  <ItemGroup Condition="!Exists('../public-repo/LICENSE') And Exists('../LICENSE')">
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
