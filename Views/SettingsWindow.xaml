<Window x:Class="PlainClip.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PlainClip.Views"
        xmlns:l="clr-namespace:PlainClip.Core.Localization;assembly=PlainClip.Core"
        Title="{x:Static l:Strings.SettingsTitle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="12,3,0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Margin" Value="32,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 畳んだ説明（見出し「詳しい説明」。既定は閉じる） -->
        <Style x:Key="Details" TargetType="Expander">
            <Setter Property="Margin" Value="12,4,0,0" />
            <Setter Property="IsExpanded" Value="False" />
            <!-- 要素ではなく文字列で渡す（スタイルの要素は複数の Expander で共有できないため） -->
            <Setter Property="Header" Value="{x:Static l:Strings.SettingsDetails}" />
            <Setter Property="AutomationProperties.Name" Value="{x:Static l:Strings.SettingsDetails}" />
        </Style>
    </Window.Resources>

    <!-- 文字の拡大・小さい画面でも操作ボタンへ届くよう、設定項目だけをスクロールさせ、ボタンとバージョン表示は下に固定する（V2.0.1）。
         画面の高さは作業領域までに抑える（UiLook.FitToWorkArea）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="18,14,18,0">
                <!-- クリップボードを書式なしで貼り付け（V2.0.0: 履歴の先頭ではなく、現在のクリップボードのテキスト） -->
                <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Strings.SettingsPasteHeading}" />
                <TextBlock Style="{StaticResource Note}" Margin="12,0,0,4" Text="{x:Static l:Strings.SettingsPasteNote}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PasteDoubleTap" GroupName="Paste" Content="{x:Static l:Strings.SettingsDoubleTap}" />
                    <ComboBox x:Name="DoubleTapKeyCombo" MinWidth="150" Margin="10,0,0,0" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Static l:Strings.SettingsDoubleTapKeyName}" />
                </StackPanel>
                <TextBlock x:Name="DoubleTapNote" Style="{StaticResource Status}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PasteShortcut" GroupName="Paste" Content="{x:Static l:Strings.SettingsShortcut}" />
                    <v:ShortcutBox x:Name="PasteShortcutBox" MinWidth="150" Margin="10,0,0,0" Padding="2" />
                </StackPanel>
                <RadioButton x:Name="PasteDisabled" GroupName="Paste" Content="{x:Static l:Strings.SettingsDisabled}" />
                <TextBlock x:Name="PasteStatus" Style="{StaticResource Status}" />

                <!-- 履歴一覧を表示 -->
                <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Strings.SettingsHistoryHeading}" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HistoryShortcut" GroupName="History" Content="{x:Static l:Strings.SettingsShortcut}" />
                    <v:ShortcutBox x:Name="HistoryShortcutBox" MinWidth="150" Margin="10,0,0,0" Padding="2" />
                </StackPanel>
                <RadioButton x:Name="HistoryDisabled" GroupName="History" Content="{x:Static l:Strings.SettingsHistoryDisabled}" />
                <TextBlock x:Name="HistoryStatus" Style="{StaticResource Status}" />

                <!-- 長い説明は畳んでおき、読みたいときだけ開く（V2.0.0） -->
                <Expander Style="{StaticResource Details}">
                    <TextBlock Style="{StaticResource Note}" Margin="18,2,0,0" Text="{x:Static l:Strings.SettingsShortcutNote}" />
                </Expander>

                <!-- 数字ショートカット（V2.0.0） -->
                <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Strings.SettingsNumberHeading}" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal" Margin="12,2,0,2">
                    <ComboBox x:Name="NumberCombo" MinWidth="220" AutomationProperties.Name="{x:Static l:Strings.SettingsNumberHeading}" />
                </StackPanel>
                <TextBlock x:Name="NumberStatus" Style="{StaticResource Status}" Margin="12,2,0,0" />
                <Expander Style="{StaticResource Details}">
                    <TextBlock Style="{StaticResource Note}" Margin="18,2,0,0" Text="{x:Static l:Strings.SettingsNumberNote}" />
                </Expander>

                <!-- その他 -->
                <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Strings.SettingsOtherHeading}" Margin="0,16,0,6" />
                <CheckBox x:Name="AutoStart" Content="{x:Static l:Strings.SettingsAutoStart}" Margin="12,2,0,4" />
                <StackPanel Orientation="Horizontal" Margin="12,2,0,4">
                    <TextBlock Text="{x:Static l:Strings.SettingsMaxCount}" VerticalAlignment="Center" />
                    <ComboBox x:Name="MaxCount" MinWidth="70" Margin="10,0,0,0" AutomationProperties.Name="{x:Static l:Strings.SettingsMaxCount}" />
                    <TextBlock Text="{x:Static l:Strings.SettingsMaxCountUnit}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="MergeDuplicates" Margin="12,2,0,4">
                    <TextBlock Text="{x:Static l:Strings.SettingsMergeDuplicates}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="12,6,0,0">
                    <TextBlock Text="{x:Static l:Strings.SettingsLanguage}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="LanguageCombo" MinWidth="220" AutomationProperties.Name="{x:Static l:Strings.SettingsLanguage}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Margin="12,2,0,0" Text="{x:Static l:Strings.SettingsLanguageNote}" />
                <TextBlock Style="{StaticResource Note}" Margin="12,8,0,2" Text="{x:Static l:Strings.SettingsMemoryNote}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="18,0,18,14">
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <DockPanel Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                    <Button x:Name="OkButton" Content="{x:Static l:Strings.Ok}" MinWidth="80" Padding="8,3" IsDefault="True" Click="Ok_Click" />
                    <!-- 設定画面は Show()（モードレス）で開くため、IsCancel だけでは閉じない。Click で閉じる（Esc も同じ処理）。 -->
                    <Button Content="{x:Static l:Strings.Cancel}" MinWidth="80" Padding="8,3" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ApplyButton" Content="{x:Static l:Strings.Apply}" MinWidth="80" Padding="8,3" Margin="8,0,0,0" Click="Apply_Click" />
                </StackPanel>
            </DockPanel>

            <!-- 一番下: バージョン・© ja1bus・ライセンス表記（V2.0.0。PROJECT.md「ライセンス表記」）。
                 全文は同梱の LICENSE をこの画面から表示し、Web だけに頼らない。 -->
            <Border BorderBrush="{x:Static SystemColors.ControlLightBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <!-- 診断ログ（V2.1.0）: 記録中だけ表示する。バージョン表示を Ctrl+Shift+クリックで始める（サポート用。PROJECT.md「診断ログ」）。 -->
                    <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="DiagnosticsText" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0">
                            <Hyperlink Click="OnOpenDiagnostics">
                                <Run Text="{x:Static l:Strings.DiagnosticsOpenFolder}" />
                            </Hyperlink>
                            <Run Text=" · " />
                            <Hyperlink Click="OnStopDiagnostics">
                                <Run Text="{x:Static l:Strings.DiagnosticsStop}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Note}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0">
                        <Hyperlink Click="OnShowLicense" ToolTip="{x:Static l:Strings.SettingsLicenseToolTip}">
                            <Run Text="{x:Static l:Strings.SettingsLicenseLink}" />
                        </Hyperlink>
                        <Run Text=" · " />
                        <Hyperlink x:Name="SourceLink" Click="OnOpenSource">
                            <Run Text="{x:Static l:Strings.SettingsSourceLink}" />
                        </Hyperlink>
                        <Run Text=" · " />
                        <Hyperlink Click="OnOpenNotices" ToolTip="{x:Static l:Strings.SettingsNoticesToolTip}">
                            <Run Text="{x:Static l:Strings.SettingsNoticesLink}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0">
                        <Hyperlink x:Name="WebsiteLink" Click="OnOpenWebsite">
                            <Run Text="{x:Static l:Strings.SettingsWebsiteLink}" />
                        </Hyperlink>
                        <Run Text=" · " />
                        <Hyperlink x:Name="PrivacyLink" Click="OnOpenPrivacy">
                            <Run Text="{x:Static l:Strings.SettingsPrivacyLink}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
